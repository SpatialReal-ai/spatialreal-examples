# Copy this file to .env and fill it in.

# From SpatialReal Studio (https://app.spatialreal.ai). Use the same avatar as your agent.
VITE_SPATIALREAL_APP_ID=
VITE_SPATIALREAL_AVATAR_ID=

# Read by server.js only. Never give these a VITE_ prefix: that would put them in the page.
SPATIALREAL_API_KEY=

# From your LiveKit project: the same project your agent runs on
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
