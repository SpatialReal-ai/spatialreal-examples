# The variables the voice_assistant_spatialreal graph reads. Add them to TEN's own
# ai_agents/.env (TEN reads only that file), not to a .env in this folder.

# From SpatialReal Studio (https://app.spatialreal.ai)
SPATIALREAL_API_KEY=
SPATIALREAL_AVATAR_ID=
# Optional: sent as X-App-ID when set
SPATIALREAL_APP_ID=

# From your Agora project (https://console.agora.io): the same project the web client uses
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# The voice pipeline of voice_assistant_spatialreal: Deepgram (speech to text),
# Groq through the OpenAI-compatible LLM extension (the replies), Cartesia (text to speech)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_TTS_KEY=

# Only for the "Without TEN: Python SDK" snippet, which reads a .env in this folder:
# copy the SpatialReal and Agora values above, plus these two
AGORA_CHANNEL=spatialreal-demo
AVATAR_UID=1001
