# Copy this file to .env and fill it in.

# From SpatialReal Studio (https://app.spatialreal.ai). Use the same avatar as your Host mode server.
VITE_SPATIALREAL_APP_ID=
VITE_SPATIALREAL_AVATAR_ID=

# Your Host mode server (../../server runs on this address)
VITE_HOST_SERVER_URL=ws://localhost:8765

# Read by server.js only, to download the avatar. Never give it a VITE_ prefix.
SPATIALREAL_API_KEY=
