# Copy this file to .env and fill it in.

# From SpatialReal Studio (https://app.spatialreal.ai). Use the same avatar as your bot.
VITE_SPATIALREAL_APP_ID=
VITE_SPATIALREAL_AVATAR_ID=

# daily or livekit: the transport your bot runs with (-t)
VITE_PIPECAT_TRANSPORT=daily

# Read by server.js only. Never give it a VITE_ prefix: that would put it in the page.
SPATIALREAL_API_KEY=
