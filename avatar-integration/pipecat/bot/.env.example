# Copy this file to .env and fill it in.

# From SpatialReal Studio (https://app.spatialreal.ai)
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=

# The voice pipeline
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Daily: the bot creates a room for every session
DAILY_API_KEY=

# Or LiveKit, when you run the bot with -t livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
