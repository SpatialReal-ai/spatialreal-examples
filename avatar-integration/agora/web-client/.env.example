# Copy this file to .env and fill it in. Only server.js reads it: none of these values
# has a VITE_ prefix, so none of them is built into the page.

# From SpatialReal Studio (https://app.spatialreal.ai). Use the same avatar as your agent.
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=

# From your Agora project (https://console.agora.io): the same project your agent uses.
# Leave AGORA_APP_CERTIFICATE empty only for a testing-mode project without a certificate.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# The channel your agent publishes the avatar into, and the uids in it
AGORA_CHANNEL=spatialreal-demo
# The uid SpatialReal publishes the avatar with: the agent's avatar uid
AVATAR_UID=1001
# This page's uid: the agent listens to this uid's microphone
USER_UID=2001
